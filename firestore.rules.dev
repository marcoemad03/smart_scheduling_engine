rules_version = '2';

// ============================================================================
// DEVELOPMENT-ONLY RULES - DO NOT SHIP TO PRODUCTION
// ============================================================================
// Temporary workaround for firebase/flutterfire#13212: on Windows desktop,
// cloud_firestore does not receive the firebase_auth credentials, so every
// request arrives unauthenticated and the production rules in
// firestore.rules deny it ("permission-denied").
//
// These rules open the whole database. Use them ONLY while developing /
// testing the Windows desktop client against the shared dev project.
//
// Restore production rules with:
//   firebase deploy --only firestore:rules   (firebase.json points to
//                                             firestore.rules = production)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
